<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>FilmCraft</string>
  <key>CFBundleName</key>
  <string>FilmCraft</string>
  <key>CFBundleExecutable</key>
  <string>FilmCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.filmcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>FilmCraftVersion</key>
  <string>@VERSION@</string>
  <key>FilmCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>FilmCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.video</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Voice-over recording (timeline track header ▸ Voice-over Record) reads the microphone.
       Without this string macOS never asks and the app gets no input. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>FilmCraft uses the microphone to record voice-over onto the timeline.</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the FilmCraft authors. MIT OR Apache-2.0.</string>

  <!-- Finder opens a project by this claim. The exported type alone is not enough:
       without it Launch Services reports that FilmCraft cannot open a FilmCraft Project (#1229). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>FilmCraft Project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.filmcraft.project</string>
      </array>
    </dict>
    <!-- Media Finder may open with FilmCraft (Open With, drops on the Dock icon, `open -a`): it is
         imported into the project, as a launch argument is. Alternate: FilmCraft never becomes
         the default app for movies, sounds or images. The files arrive through the open-documents
         Apple event (apps/filmcraft/src/apple_events.rs); without these claims Launch Services
         reports that FilmCraft cannot open files in that format. Formats without a system type
         (MXF, VOB, Y4M, Ogg, Opus, DPX) still import through File ▸ Import, drops and arguments. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Movie</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mpeg-4</string>
        <string>com.apple.m4v-video</string>
        <string>com.apple.quicktime-movie</string>
        <string>public.avi</string>
        <string>public.mpeg</string>
        <string>public.mpeg-2-video</string>
        <string>public.mpeg-2-transport-stream</string>
        <string>public.3gpp</string>
        <string>org.matroska.mkv</string>
        <string>org.webmproject.webm</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Audio</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.waveform-audio</string>
        <string>public.aiff-audio</string>
        <string>public.mp3</string>
        <string>public.mp2</string>
        <string>public.mpeg-4-audio</string>
        <string>public.aac-audio</string>
        <string>org.xiph.flac</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.png</string>
        <string>public.jpeg</string>
        <string>com.compuserve.gif</string>
        <string>org.webmproject.webp</string>
        <string>public.tiff</string>
        <string>com.microsoft.bmp</string>
        <string>com.truevision.tga-image</string>
        <string>com.ilm.openexr-image</string>
        <string>public.radiance</string>
        <string>com.adobe.raw-image</string>
      </array>
    </dict>
  </array>

  <!-- Filmcraft's own format. -->
  <!-- Container formats macOS declares no type for; imported so the Movie claim above resolves. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.matroska.mkv</string>
      <key>UTTypeDescription</key>
      <string>Matroska Video</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>mkv</string></array>
        <key>public.mime-type</key>
        <array><string>video/x-matroska</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.webmproject.webm</string>
      <key>UTTypeDescription</key>
      <string>WebM Video</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>webm</string></array>
        <key>public.mime-type</key>
        <array><string>video/webm</string></array>
      </dict>
    </dict>
  </array>

  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.filmcraft.project</string>
      <key>UTTypeDescription</key>
      <string>FilmCraft Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.json</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>FilmCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>fcproj</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-filmcraft</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
