<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Filmcraft. Deliberately minimal: the app is pure Rust,
     loads no unsigned code, needs no JIT, and is not sandboxed (it opens files by path, from the
     command line and drag-and-drop). Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- Voice-over recording reads the microphone; the hardened runtime blocks audio input without
       this (Info.plist.in carries the matching NSMicrophoneUsageDescription). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Blackmagic RAW: .braw files are decoded by Blackmagic's runtime (BlackmagicRawAPI.framework),
       which the user installs and Blackmagic signs. Library validation only lets the hardened
       runtime load code signed by FilmCraft's own team or Apple, so it refuses that framework
       without this (docs/adr/0001-platform-ffi.md, crates/platform/src/braw). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
