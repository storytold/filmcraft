<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.filmcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>FilmCraft</name>
  <summary>Edit video, color and sound</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      FilmCraft is a video editor. Edit video, color and sound
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.filmcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.filmcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/filmcraft</url>
  <url type="bugtracker">https://github.com/storytold/filmcraft/issues</url>
  <url type="help">https://github.com/storytold/filmcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>AudioVideoEditing</category>
  </categories>
  <keywords>
    <keyword>video</keyword>
    <keyword>video editor</keyword>
    <keyword>timeline</keyword>
    <keyword>color grading</keyword>
    <keyword>nle</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Color workspace: a documentary cut with Color Grade, scopes, captions and loudness meters</caption>
      <image>https://raw.githubusercontent.com/storytold/filmcraft/main/docs/images/filmcraft-hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>filmcraft</binary>
    <mediatype>application/x-filmcraft</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
