;; A raw RGB image format plugin, hand written for the host tests. It reads and writes files with a
;; 12 byte header: the magic "RGB8", then width and height as u32 little endian, then packed R, G, B
;; bytes. A read answers opaque RGBA. A write drops alpha.
;;
;; Entry 0 is the only entry. The request JSON carries "op":"read" or "op":"write". A read gets the
;; file as the blob. A write gets W*H*4 RGBA bytes as the blob and the size in "doc". Answers are the
;; JSON shapes of `craft_plugin_abi::format`. A bad file is an {"error"} answer, not a trap.
;; The allocator only grows. Each test call runs on a fresh instance or a short lived one.
(module
  (memory (export "memory") 2 1024)
  (global $heap (mut i32) (i32.const 4096))
  (data (i32.const 16) "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
  (data (i32.const 88) "\"op\":\"")
  (data (i32.const 104) "\"width\":")
  (data (i32.const 120) "\"height\":")
  (data (i32.const 144) "{\"doc\":{\"kind\":\"image\",\"width\":")
  (data (i32.const 184) ",\"height\":")
  (data (i32.const 208) ",\"rgba8\":\"")
  (data (i32.const 232) "\"}}")
  (data (i32.const 248) "{\"bytes\":\"")
  (data (i32.const 272) "\"}")
  (data (i32.const 288) "{\"error\":\"the file is shorter than its 12 byte header\"}")
  (data (i32.const 352) "{\"error\":\"not a raw RGB file: the magic is not RGB8\"}")
  (data (i32.const 416) "{\"error\":\"the pixel data does not match the width and height\"}")
  (data (i32.const 488) "{\"error\":\"the request has no width and height\"}")
  (data (i32.const 544) "RGB8")

  (func $alloc (param $len i32) (param $align i32) (result i32)
    (local $p i32) (local $end i32) (local $have i32) (local $need i32)
    (local.set $p (i32.and (i32.add (global.get $heap) (i32.const 7)) (i32.const -8)))
    (local.set $end (i32.add (local.get $p) (local.get $len)))
    (if (i32.lt_u (local.get $end) (local.get $p)) (then (return (i32.const 0))))
    (local.set $have (i32.shl (memory.size) (i32.const 16)))
    (if (i32.gt_u (local.get $end) (local.get $have)) (then
      (local.set $need (i32.shr_u (i32.add (i32.sub (local.get $end) (local.get $have)) (i32.const 65535)) (i32.const 16)))
      (if (i32.eq (memory.grow (local.get $need)) (i32.const -1)) (then (return (i32.const 0))))))
    (global.set $heap (local.get $end))
    (local.get $p))

  (func $pack (param $ptr i32) (param $len i32) (result i64)
    (i64.or (i64.shl (i64.extend_i32_u (local.get $len)) (i64.const 32)) (i64.extend_i32_u (local.get $ptr))))

  ;; index of `needle` in `hay`, or -1
  (func $find (param $hay i32) (param $hl i32) (param $nd i32) (param $nl i32) (result i32)
    (local $i i32) (local $j i32)
    (if (i32.lt_u (local.get $hl) (local.get $nl)) (then (return (i32.const -1))))
    (block $none (loop $outer
      (br_if $none (i32.gt_u (local.get $i) (i32.sub (local.get $hl) (local.get $nl))))
      (local.set $j (i32.const 0))
      (block $miss (loop $inner
        (br_if $miss (i32.ne
          (i32.load8_u (i32.add (local.get $hay) (i32.add (local.get $i) (local.get $j))))
          (i32.load8_u (i32.add (local.get $nd) (local.get $j)))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (if (i32.eq (local.get $j) (local.get $nl)) (then (return (local.get $i))))
        (br $inner)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $outer)))
    (i32.const -1))

  ;; the unsigned decimal number after `needle` in the request, or -1
  (func $number_after (param $req i32) (param $rl i32) (param $nd i32) (param $nl i32) (result i64)
    (local $at i32) (local $v i64) (local $c i32) (local $digits i32)
    (local.set $at (call $find (local.get $req) (local.get $rl) (local.get $nd) (local.get $nl)))
    (if (i32.lt_s (local.get $at) (i32.const 0)) (then (return (i64.const -1))))
    (local.set $at (i32.add (local.get $at) (local.get $nl)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $at) (local.get $rl)))
      (local.set $c (i32.sub (i32.load8_u (i32.add (local.get $req) (local.get $at))) (i32.const 48)))
      (br_if $done (i32.gt_u (local.get $c) (i32.const 9)))
      (local.set $v (i64.add (i64.mul (local.get $v) (i64.const 10)) (i64.extend_i32_u (local.get $c))))
      (br_if $done (i64.gt_u (local.get $v) (i64.const 4294967295)))
      (local.set $digits (i32.add (local.get $digits) (i32.const 1)))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      (br $l)))
    (if (i32.eqz (local.get $digits)) (then (return (i64.const -1))))
    (if (i64.gt_u (local.get $v) (i64.const 4294967295)) (then (return (i64.const -1))))
    (local.get $v))

  ;; write `n` in decimal at `dst`, return the end
  (func $dec (param $n i32) (param $dst i32) (result i32)
    (local $d i32) (local $t i32) (local $len i32)
    (local.set $d (i32.const 1))
    (local.set $t (local.get $n))
    (block $done (loop $count
      (br_if $done (i32.lt_u (local.get $t) (i32.const 10)))
      (local.set $t (i32.div_u (local.get $t) (i32.const 10)))
      (local.set $d (i32.add (local.get $d) (i32.const 1)))
      (br $count)))
    (local.set $len (local.get $d))
    (block $done2 (loop $emit
      (br_if $done2 (i32.eqz (local.get $d)))
      (local.set $d (i32.sub (local.get $d) (i32.const 1)))
      (i32.store8 (i32.add (local.get $dst) (local.get $d)) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10))))
      (local.set $n (i32.div_u (local.get $n) (i32.const 10)))
      (br $emit)))
    (i32.add (local.get $dst) (local.get $len)))

  (func $copy (param $dst i32) (param $src i32) (param $len i32) (result i32)
    (memory.copy (local.get $dst) (local.get $src) (local.get $len))
    (i32.add (local.get $dst) (local.get $len)))

  ;; base64 with padding of src[0..len] at dst, return the end
  (func $b64 (param $src i32) (param $len i32) (param $dst i32) (result i32)
    (local $i i32) (local $n i32) (local $left i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (local.set $left (i32.sub (local.get $len) (local.get $i)))
      (local.set $n (i32.shl (i32.load8_u (i32.add (local.get $src) (local.get $i))) (i32.const 16)))
      (if (i32.gt_u (local.get $left) (i32.const 1)) (then
        (local.set $n (i32.or (local.get $n) (i32.shl (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 1)))) (i32.const 8))))))
      (if (i32.gt_u (local.get $left) (i32.const 2)) (then
        (local.set $n (i32.or (local.get $n) (i32.load8_u (i32.add (local.get $src) (i32.add (local.get $i) (i32.const 2))))))))
      (i32.store8 (local.get $dst) (i32.load8_u (i32.add (i32.const 16) (i32.and (i32.shr_u (local.get $n) (i32.const 18)) (i32.const 63)))))
      (i32.store8 (i32.add (local.get $dst) (i32.const 1)) (i32.load8_u (i32.add (i32.const 16) (i32.and (i32.shr_u (local.get $n) (i32.const 12)) (i32.const 63)))))
      (if (i32.gt_u (local.get $left) (i32.const 1))
        (then (i32.store8 (i32.add (local.get $dst) (i32.const 2)) (i32.load8_u (i32.add (i32.const 16) (i32.and (i32.shr_u (local.get $n) (i32.const 6)) (i32.const 63))))))
        (else (i32.store8 (i32.add (local.get $dst) (i32.const 2)) (i32.const 61))))
      (if (i32.gt_u (local.get $left) (i32.const 2))
        (then (i32.store8 (i32.add (local.get $dst) (i32.const 3)) (i32.load8_u (i32.add (i32.const 16) (i32.and (local.get $n) (i32.const 63))))))
        (else (i32.store8 (i32.add (local.get $dst) (i32.const 3)) (i32.const 61))))
      (local.set $dst (i32.add (local.get $dst) (i32.const 4)))
      (local.set $i (i32.add (local.get $i) (i32.const 3)))
      (br $l)))
    (local.get $dst))

  (func $lit (param $src i32) (param $len i32) (result i64)
    (local $out i32)
    (local.set $out (call $alloc (local.get $len) (i32.const 1)))
    (if (i32.eqz (local.get $out)) (then (return (i64.const -2))))
    (drop (call $copy (local.get $out) (local.get $src) (local.get $len)))
    (call $pack (local.get $out) (local.get $len)))

  (func $read (param $bp i32) (param $bl i32) (result i64)
    (local $w i32) (local $h i32) (local $px i64) (local $n i32) (local $rgba i32) (local $i i32)
    (local $out i32) (local $at i32) (local $cap i32)
    (if (i32.lt_u (local.get $bl) (i32.const 12)) (then (return (call $lit (i32.const 288) (i32.const 55)))))
    (if (i32.ne (i32.load (local.get $bp)) (i32.load (i32.const 544))) (then (return (call $lit (i32.const 352) (i32.const 53)))))
    (local.set $w (i32.load (i32.add (local.get $bp) (i32.const 4))))
    (local.set $h (i32.load (i32.add (local.get $bp) (i32.const 8))))
    (local.set $px (i64.mul (i64.extend_i32_u (local.get $w)) (i64.extend_i32_u (local.get $h))))
    (if (i64.gt_u (local.get $px) (i64.const 1431655765)) (then (return (call $lit (i32.const 416) (i32.const 62)))))
    (if (i64.ne (i64.mul (local.get $px) (i64.const 3)) (i64.extend_i32_u (i32.sub (local.get $bl) (i32.const 12))))
      (then (return (call $lit (i32.const 416) (i32.const 62)))))
    (local.set $n (i32.wrap_i64 (local.get $px)))
    (local.set $rgba (call $alloc (i32.shl (local.get $n) (i32.const 2)) (i32.const 1)))
    (if (i32.eqz (local.get $rgba)) (then (return (i64.const -2))))
    (block $done (loop $l
      (br_if $done (i32.eq (local.get $i) (local.get $n)))
      (i32.store8 (i32.add (local.get $rgba) (i32.shl (local.get $i) (i32.const 2))) (i32.load8_u (i32.add (local.get $bp) (i32.add (i32.const 12) (i32.mul (local.get $i) (i32.const 3))))))
      (i32.store8 (i32.add (local.get $rgba) (i32.add (i32.shl (local.get $i) (i32.const 2)) (i32.const 1))) (i32.load8_u (i32.add (local.get $bp) (i32.add (i32.const 13) (i32.mul (local.get $i) (i32.const 3))))))
      (i32.store8 (i32.add (local.get $rgba) (i32.add (i32.shl (local.get $i) (i32.const 2)) (i32.const 2))) (i32.load8_u (i32.add (local.get $bp) (i32.add (i32.const 14) (i32.mul (local.get $i) (i32.const 3))))))
      (i32.store8 (i32.add (local.get $rgba) (i32.add (i32.shl (local.get $i) (i32.const 2)) (i32.const 3))) (i32.const 255))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    ;; prefix, two numbers, base64 of 4n bytes (at most 4n/3*4 + 4), suffix
    (local.set $cap (i32.add (i32.const 128) (i32.mul (i32.div_u (i32.add (i32.shl (local.get $n) (i32.const 2)) (i32.const 2)) (i32.const 3)) (i32.const 4))))
    (local.set $out (call $alloc (local.get $cap) (i32.const 1)))
    (if (i32.eqz (local.get $out)) (then (return (i64.const -2))))
    (local.set $at (call $copy (local.get $out) (i32.const 144) (i32.const 31)))
    (local.set $at (call $dec (local.get $w) (local.get $at)))
    (local.set $at (call $copy (local.get $at) (i32.const 184) (i32.const 10)))
    (local.set $at (call $dec (local.get $h) (local.get $at)))
    (local.set $at (call $copy (local.get $at) (i32.const 208) (i32.const 10)))
    (local.set $at (call $b64 (local.get $rgba) (i32.shl (local.get $n) (i32.const 2)) (local.get $at)))
    (local.set $at (call $copy (local.get $at) (i32.const 232) (i32.const 3)))
    (call $pack (local.get $out) (i32.sub (local.get $at) (local.get $out))))

  (func $write (param $rp i32) (param $rl i32) (param $bp i32) (param $bl i32) (result i64)
    (local $w i64) (local $h i64) (local $n i32) (local $file i32) (local $i i32) (local $out i32) (local $at i32) (local $flen i32)
    (local.set $w (call $number_after (local.get $rp) (local.get $rl) (i32.const 104) (i32.const 8)))
    (local.set $h (call $number_after (local.get $rp) (local.get $rl) (i32.const 120) (i32.const 9)))
    (if (i32.or (i64.lt_s (local.get $w) (i64.const 0)) (i64.lt_s (local.get $h) (i64.const 0)))
      (then (return (call $lit (i32.const 488) (i32.const 47)))))
    (if (i64.gt_u (i64.mul (local.get $w) (local.get $h)) (i64.const 1073741823)) (then (return (call $lit (i32.const 416) (i32.const 62)))))
    (if (i64.ne (i64.mul (i64.mul (local.get $w) (local.get $h)) (i64.const 4)) (i64.extend_i32_u (local.get $bl)))
      (then (return (call $lit (i32.const 416) (i32.const 62)))))
    (local.set $n (i32.shr_u (local.get $bl) (i32.const 2)))
    (local.set $flen (i32.add (i32.const 12) (i32.mul (local.get $n) (i32.const 3))))
    (local.set $file (call $alloc (local.get $flen) (i32.const 1)))
    (if (i32.eqz (local.get $file)) (then (return (i64.const -2))))
    (i32.store (local.get $file) (i32.load (i32.const 544)))
    (i32.store (i32.add (local.get $file) (i32.const 4)) (i32.wrap_i64 (local.get $w)))
    (i32.store (i32.add (local.get $file) (i32.const 8)) (i32.wrap_i64 (local.get $h)))
    (block $done (loop $l
      (br_if $done (i32.eq (local.get $i) (local.get $n)))
      (i32.store8 (i32.add (local.get $file) (i32.add (i32.const 12) (i32.mul (local.get $i) (i32.const 3)))) (i32.load8_u (i32.add (local.get $bp) (i32.shl (local.get $i) (i32.const 2)))))
      (i32.store8 (i32.add (local.get $file) (i32.add (i32.const 13) (i32.mul (local.get $i) (i32.const 3)))) (i32.load8_u (i32.add (local.get $bp) (i32.add (i32.shl (local.get $i) (i32.const 2)) (i32.const 1)))))
      (i32.store8 (i32.add (local.get $file) (i32.add (i32.const 14) (i32.mul (local.get $i) (i32.const 3)))) (i32.load8_u (i32.add (local.get $bp) (i32.add (i32.shl (local.get $i) (i32.const 2)) (i32.const 2)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.set $out (call $alloc (i32.add (i32.const 64) (i32.mul (i32.div_u (i32.add (local.get $flen) (i32.const 2)) (i32.const 3)) (i32.const 4))) (i32.const 1)))
    (if (i32.eqz (local.get $out)) (then (return (i64.const -2))))
    (local.set $at (call $copy (local.get $out) (i32.const 248) (i32.const 10)))
    (local.set $at (call $b64 (local.get $file) (local.get $flen) (local.get $at)))
    (local.set $at (call $copy (local.get $at) (i32.const 272) (i32.const 2)))
    (call $pack (local.get $out) (i32.sub (local.get $at) (local.get $out))))

  (func (export "craft_abi") (result i32) i32.const 1)
  (export "craft_alloc" (func $alloc))
  (func (export "craft_free") (param i32 i32 i32))

  (func (export "craft_invoke") (param $e i32) (param $rp i32) (param $rl i32) (param $bp i32) (param $bl i32) (result i64)
    (local $at i32) (local $c i32)
    (if (i32.ne (local.get $e) (i32.const 0)) (then (return (i64.const -1))))
    (local.set $at (call $find (local.get $rp) (local.get $rl) (i32.const 88) (i32.const 6)))
    (if (i32.lt_s (local.get $at) (i32.const 0)) (then (return (i64.const -1))))
    (local.set $c (i32.load8_u (i32.add (local.get $rp) (i32.add (local.get $at) (i32.const 6)))))
    (if (i32.eq (local.get $c) (i32.const 114)) (then (return (call $read (local.get $bp) (local.get $bl)))))
    (if (i32.eq (local.get $c) (i32.const 119)) (then (return (call $write (local.get $rp) (local.get $rl) (local.get $bp) (local.get $bl)))))
    (i64.const -1))
)
